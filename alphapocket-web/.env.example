# AlphaPocket V4-β 环境变量样例
# 用法：cp .env.example .env

# ---------- 端口（§3.2）----------
WEB_PORT=8080
BFF_PORT=8081
CORE_PORT=8082

# ---------- core（前缀 AP_）----------
AP_DATABASE_URL=postgresql+psycopg://ap:ap@localhost:5432/ap
AP_REDIS_URL=redis://localhost:6379/0

# MinIO（生产映射 OSS）
AP_MINIO_ENDPOINT=localhost:9000
AP_MINIO_ACCESS_KEY=minioadmin
AP_MINIO_SECRET_KEY=minioadmin
AP_MINIO_BUCKET=ap-artifacts

# JWT（HS256；生产务必替换 AP_JWT_SECRET）
AP_JWT_SECRET=dev-only-change-me
AP_JWT_ACCESS_TTL=15m
AP_JWT_REFRESH_TTL=7d

# workspace 根目录（core 的 Ctx root 注入点，见 T0.3）
AP_WORKSPACE_ROOT=var/ws/default

# ---------- bff ----------
CORE_URL=http://localhost:8082

# ---------- web（前缀 VITE_）----------
VITE_API_BASE=/api
